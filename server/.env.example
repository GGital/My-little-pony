# Copy to server/.env and fill in your own local values. server/.env is git-ignored: never commit it.
# Every variable here is listed in docs/system-sds.md §9.1; a test checks that the lists match.

# development | test | production (Secure cookies are on in production).
NODE_ENV="development"
# Port the API listens on. Cloud Run sets it in Lab 5.
PORT="3000"
# Development database (the app and `npm run db:seed` use this one). Required.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tcg_event_hub?schema=public"
# The browser origin allowed to send POST/PATCH/DELETE (the Vite dev server locally). Required.
# Several origins are allowed, comma-separated with no spaces (Cloud Run lists both of its service URLs).
APP_ORIGIN="http://localhost:5173"
# silent | error | warn | info | debug
LOG_LEVEL="info"
# Number of proxies in front of the server: 0 locally, 1 on Cloud Run.
TRUST_PROXY="0"

# Used by the tests only. Tests TRUNCATE every table here, so it must never point at the development database.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/tcg_event_hub_test?schema=public"
# Used by the seed script only: the password of every seeded demo account (at least 12 characters). Choose your own.
SEED_PASSWORD="CHANGE_ME_LOCAL_ONLY"
