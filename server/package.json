{
  "name": "tcg-event-hub-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset:test": "node --env-file=.env scripts/test-db.mjs --reset",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:test": "node --env-file=.env scripts/test-db.mjs",
    "e2e:api": "node --env-file=.env scripts/e2e-api.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "5.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.18.12",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
