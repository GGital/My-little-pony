// TCG Event Hub data model, Sprints 1 to 3 (System-Level SDS §4.1; Sprint 1 contracts §1 SR-01;
// Sprint 2 contracts §1 SR-08).
// Rules that Prisma cannot express (CHECK constraints, the partial unique index) live in raw SQL migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

enum EventType {
  CASUAL
  TOURNAMENT
  RELEASE
}

enum EventFormat {
  CONSTRUCTED
  SEALED
  DRAFT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  CHECKED_IN
  CANCELLED
  EVENT_CANCELLED
}

/// The trading card game of an event or a store (Sprint 2, CH-11, FR-29, FR-30). Shown by name only (X-14).
enum Game {
  POKEMON
  MAGIC
  ONE_PIECE
  YUGIOH
  DIGIMON
  LORCANA
  OTHER
}

/// Which part of an event an EventChange row records (Sprint 2 contracts §1, FR-28).
enum ChangeField {
  status
  details
  capacity
  deadline
  /// Sprint 3 (Feature-P, FR-28): a check-in or an undo; the row also names the registration.
  attendance
}

model User {
  id              Int            @id @default(autoincrement())
  email           String         @unique @db.VarChar(254)
  displayName     String         @db.VarChar(40)
  passwordHash    String
  role            Role
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  // Sprint 2, organizers only: the store's games and public contact (FR-30, D-37). Never the sign-in email.
  games           Game[]         @default([])
  contactPhone    String?        @db.VarChar(20)
  contactEmail    String?        @db.VarChar(254)
  contactWebsite  String?        @db.VarChar(200)
  contactLine     String?        @db.VarChar(40)
  sessions        Session[]
  events          Event[]        @relation("OrganizerEvents")
  cancelledEvents Event[]        @relation("CancelledEvents")
  registrations   Registration[] @relation("Participant")
  eventChanges    EventChange[]
  checkIns        Registration[] @relation("CheckedInBy")
}

model Session {
  id        String   @id @db.Char(64) // SHA-256 of the cookie token, never the token itself (SDS SD-07)
  userId    Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Event {
  id                   Int            @id @default(autoincrement())
  organizerId          Int
  title                String         @db.VarChar(100)
  type                 EventType
  format               EventFormat
  venueName            String         @db.VarChar(80)
  venueAddress         String         @db.VarChar(200)
  city                 String         @db.VarChar(60)
  startAt              DateTime       @db.Timestamptz(3)
  endAt                DateTime       @db.Timestamptz(3)
  capacity             Int
  feeLabel             String?        @db.VarChar(40)
  structureNote        String?        @db.VarChar(80)
  contact              String?        @db.VarChar(120)
  description          String?        @db.VarChar(2000)
  status               EventStatus    @default(PUBLISHED)
  publishedAt          DateTime?      @db.Timestamptz(3)
  // Sprint 2 (SR-08): null deadline = the start time (BR-08); the cancel fields are all set or all null (BR-12).
  registrationDeadline DateTime?      @db.Timestamptz(3)
  cancelledAt          DateTime?      @db.Timestamptz(3)
  cancelledById        Int?
  cancelReason         String?        @db.VarChar(200)
  game                 Game           @default(OTHER)
  seedKey              String?        @unique @db.VarChar(40) // set only by the seed, so re-runs find their rows
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  organizer            User           @relation("OrganizerEvents", fields: [organizerId], references: [id])
  cancelledBy          User?          @relation("CancelledEvents", fields: [cancelledById], references: [id])
  registrations        Registration[]
  changes              EventChange[]

  @@index([status, startAt])
  @@index([organizerId])
}

model Registration {
  id            Int                @id @default(autoincrement())
  eventId       Int
  participantId Int
  status        RegistrationStatus @default(REGISTERED)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  cancelledAt   DateTime?          @db.Timestamptz(3) // set with CANCELLED / EVENT_CANCELLED (Sprint 2, FR-28)
  // Sprint 3 (Feature-P, BR-19): both set if and only if CHECKED_IN (CHECK registration_checkin_fields).
  checkedInAt   DateTime?          @db.Timestamptz(3)
  checkedInById Int?
  event         Event              @relation(fields: [eventId], references: [id])
  participant   User               @relation("Participant", fields: [participantId], references: [id])
  checkedInBy   User?              @relation("CheckedInBy", fields: [checkedInById], references: [id])
  changes       EventChange[]

  @@index([eventId])
  @@index([participantId])
}

/// One row of an event's change history (Sprint 2, SR-08, FR-28). Append-only: a trigger rejects UPDATE and DELETE (X-11).
model EventChange {
  id             Int           @id @default(autoincrement())
  eventId        Int
  changedById    Int
  field          ChangeField
  oldValue       String?
  newValue       String
  changedAt      DateTime      @db.Timestamptz(3)
  /// Sprint 3: set on attendance rows (Feature-P), so a check-in names the registration it changed.
  registrationId Int?
  event          Event         @relation(fields: [eventId], references: [id])
  changedBy      User          @relation(fields: [changedById], references: [id])
  registration   Registration? @relation(fields: [registrationId], references: [id])

  @@index([eventId, changedAt])
}
