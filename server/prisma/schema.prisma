// TCG Event Hub data model, Sprint 1 (System-Level SDS §4.1; Sprint 1 contracts §1 SR-01).
// Rules that Prisma cannot express (CHECK constraints, the partial unique index) live in raw SQL migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

enum EventType {
  CASUAL
  TOURNAMENT
  RELEASE
}

enum EventFormat {
  CONSTRUCTED
  SEALED
  DRAFT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  CHECKED_IN
  CANCELLED
  EVENT_CANCELLED
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique @db.VarChar(254)
  displayName   String         @db.VarChar(40)
  passwordHash  String
  role          Role
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  sessions      Session[]
  events        Event[]        @relation("OrganizerEvents")
  registrations Registration[]
}

model Session {
  id        String   @id @db.Char(64) // SHA-256 of the cookie token, never the token itself (SDS SD-07)
  userId    Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Event {
  id            Int            @id @default(autoincrement())
  organizerId   Int
  title         String         @db.VarChar(100)
  type          EventType
  format        EventFormat
  venueName     String         @db.VarChar(80)
  venueAddress  String         @db.VarChar(200)
  city          String         @db.VarChar(60)
  startAt       DateTime       @db.Timestamptz(3)
  endAt         DateTime       @db.Timestamptz(3)
  capacity      Int
  feeLabel      String?        @db.VarChar(40)
  structureNote String?        @db.VarChar(80)
  contact       String?        @db.VarChar(120)
  description   String?        @db.VarChar(2000)
  status        EventStatus    @default(PUBLISHED)
  publishedAt   DateTime?      @db.Timestamptz(3)
  seedKey       String?        @unique @db.VarChar(40) // set only by the seed, so re-runs find their rows
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  organizer     User           @relation("OrganizerEvents", fields: [organizerId], references: [id])
  registrations Registration[]

  @@index([status, startAt])
  @@index([organizerId])
}

model Registration {
  id            Int                @id @default(autoincrement())
  eventId       Int
  participantId Int
  status        RegistrationStatus @default(REGISTERED)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  event         Event              @relation(fields: [eventId], references: [id])
  participant   User               @relation(fields: [participantId], references: [id])

  @@index([eventId])
  @@index([participantId])
}
